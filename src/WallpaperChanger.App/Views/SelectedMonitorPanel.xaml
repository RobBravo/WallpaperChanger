<UserControl x:Class="WallpaperChanger.App.Views.SelectedMonitorPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Padding="16" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock FontSize="16" FontWeight="SemiBold" Text="Selected monitor" />
                <TextBlock Margin="0,4,0,16" Foreground="#475569" Text="{Binding MonitorId}" />

                <TextBlock FontWeight="SemiBold" Text="Wallpaper folder" />
                <Grid Margin="0,4,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox MinWidth="0" Text="{Binding FolderPath, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Grid.Column="1" Margin="8,0,0,0" Padding="10,4" Command="{Binding BrowseFolderCommand}" Content="Browse" />
                </Grid>

                <TextBlock FontWeight="SemiBold" Text="Interval" />
                <StackPanel Margin="0,4,0,12" Orientation="Horizontal">
                    <TextBox Width="72" Text="{Binding IntervalValue, UpdateSourceTrigger=LostFocus}" />
                    <ComboBox Width="108" Margin="8,0,0,0" ItemsSource="{Binding IntervalUnits}" SelectedItem="{Binding IntervalUnit, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <TextBlock FontWeight="SemiBold" Text="Proposal" />
                <ContentControl Visibility="Collapsed"
                                Content="{Binding ProposedImagePath, NotifyOnTargetUpdated=True}"
                                TargetUpdated="ProposalPathUpdated" />
                <Border Height="156" Margin="0,4,0,8" Background="#E2E8F0" CornerRadius="4">
                    <Grid>
                        <Image x:Name="ProposalPreview" Stretch="UniformToFill" />
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#475569" Text="No proposal thumbnail" />
                    </Grid>
                </Border>
                <TextBlock Text="{Binding ProposedImageFileName, TargetNullValue=Create a proposal to preview an image}" TextTrimming="CharacterEllipsis" />
                <TextBlock Margin="0,2,0,12" Foreground="#475569" Text="{Binding ImageCount, StringFormat=Images available: {0}}" />

                <StackPanel Orientation="Horizontal">
                    <Button Padding="12,4" Command="{Binding NewProposalCommand}" Content="New Proposal" IsEnabled="{Binding CanCreateProposal}" />
                    <Button Margin="8,0,0,0" Padding="12,4" Command="{Binding ApplyNowCommand}" Content="Apply" IsEnabled="{Binding CanApplyProposal}" />
                </StackPanel>
                <TextBlock Margin="0,6,0,0" Foreground="#9F1239" TextWrapping="Wrap" Text="{Binding ProposalActionExplanation}" />
                <TextBlock Margin="0,8,0,0" Foreground="#475569" TextWrapping="Wrap" Text="{Binding ProposalStatus}" />
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
