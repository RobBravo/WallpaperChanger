<UserControl x:Class="WallpaperChanger.App.Views.MonitorRowView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinHeight="150">
    <Border Margin="0,0,0,12" Padding="12" BorderBrush="#DDD" BorderThickness="1" CornerRadius="6">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding MonitorId}" />

            <TextBox Grid.Row="0" Grid.Column="1" MinWidth="280" Margin="0,0,8,8" Text="{Binding FolderPath, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Row="0" Grid.Column="2" Margin="0,0,0,8" Padding="12,4" Command="{Binding BrowseFolderCommand}" Content="Browse" />

            <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="Interval" />
            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                <TextBox Width="80" Margin="0,0,8,0" Text="{Binding IntervalValue, UpdateSourceTrigger=LostFocus}" />
                <ComboBox Width="120" ItemsSource="{Binding IntervalUnits}" SelectedItem="{Binding IntervalUnit, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                <Button Padding="14,4" Command="{Binding NewProposalCommand}" Content="New Proposal" />
                <Button Margin="8,0,0,0" Padding="14,4" Command="{Binding ApplyNowCommand}" Content="Apply Now" />
            </StackPanel>

            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ImageCount, StringFormat=Images: {0}}" />
            <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding ProposedImageFileName}" />
            <TextBlock Grid.Row="3" Grid.Column="0" Text="{Binding ProposalStatus}" />
        </Grid>
    </Border>
</UserControl>
