<Window x:Class="WallpaperChanger.App.MainWindow"
         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:views="clr-namespace:WallpaperChanger.App.Views"
         Title="WalpaperChangeer - La mejor forma de gestionar tus fondos de escritorio"
         Icon="/Assets/WallpaperChanger.ico"
         WindowState="Maximized"
         Height="450"
         Width="900"
         MinHeight="450"
         MinWidth="720">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,12">
            <TextBlock FontSize="20" FontWeight="SemiBold" Text="WallpaperChanger" />
            <TextBlock Margin="0,4,0,0" Foreground="#666" Text="Configure each connected monitor." />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <views:MonitorCanvasView ItemsSource="{Binding VirtualMonitors}"
                                      SelectedMonitor="{Binding SelectedVirtualMonitor, Mode=TwoWay}" />

            <views:SelectedMonitorPanel Grid.Column="1"
                                        Margin="16,0,0,0"
                                        DataContext="{Binding SelectedMonitorRow}" />
        </Grid>

        <TextBlock Grid.Row="2"
                   Margin="0,12,0,0"
                   Foreground="DarkRed"
                   Text="{Binding StatusMessage}" />
    </Grid>
</Window>
